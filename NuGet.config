<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for Cursory (CUR-T22).

    1. lib/local-packages/ (relative to this file): the MindAttic.* private packages Cursory references
       (MindAttic.Vault), checked into git so GitHub's build agents can restore without the developer's
       C:\LocalNuGet, which they don't have (NU1301 broke the Azure deploy).
    2. nuget.org: everything else.

  When you bump MindAttic.Vault, copy the new .nupkg from C:\LocalNuGet into lib/local-packages/ and update
  the PackageReference in Cursory.Core.csproj.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>