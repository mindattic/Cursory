@page "/login"
@layout Layout.MainLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Sign in · Cursory</PageTitle>

<div class="login-shell">
    <form method="post" action="/api/auth/login" class="login-card">
        <h1>Cursory</h1>
        <p class="login-sub">Cooperative cursor puzzles. Sign in to enter the room.</p>
        @if (showError)
        {
            <div class="login-error">Invalid username or password.</div>
        }
        <label>
            Username
            <input type="text" name="username" autocomplete="username" autofocus required value="@DefaultUsername" />
        </label>
        <label>
            Password
            <input type="password" name="password" autocomplete="current-password" required value="@DefaultPassword" />
        </label>
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <AntiforgeryToken />
        <button type="submit">Enter the room</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }

    private bool showError;
    private string? DefaultUsername;
    private string? DefaultPassword;

    protected override void OnInitialized()
    {
        showError = string.Equals(ErrorCode, "invalid", StringComparison.OrdinalIgnoreCase);

        // Dev-only auto-fill from the gitignored .env at the repo root (see Program.cs).
        if (HostEnvironment.IsDevelopment())
        {
            DefaultUsername = Configuration["CURSORY_DEV_USERNAME"];
            DefaultPassword = Configuration["CURSORY_DEV_PASSWORD"];
        }
    }
}
