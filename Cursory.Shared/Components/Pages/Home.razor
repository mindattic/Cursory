@page "/room/{Engine}"
@using Cursory.Core.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable
@rendermode RenderMode.InteractiveServer

<PageTitle>Cursory</PageTitle>

@* Each engine's client-side library is a plain CDN <script> (matching the SignalR client in
   App.razor) — loaded before OnAfterRenderAsync's dynamic import of {Engine}/room.js so
   window.THREE / window.BABYLON already exist when that module runs. Pinned exact versions. *@
@if (Engine == "three")
{
    @* Modern three.js (r150+) no longer ships a classic UMD build — only ES modules — so this
       imports the module build and assigns it to window.THREE, matching the classic-global
       pattern every other engine/room.js entry point expects (see three/room.js). *@
    <script type="module">
        import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.min.js';
        window.THREE = THREE;
    </script>
}
else if (Engine == "babylon")
{
    @* Blazor Server's static-prerender + interactive-hydrate cycle renders this component's
       markup twice, and it special-cases <script> elements to force a fresh DOM insertion (hence
       execution) each time — so this tag runs twice per page load. Babylon's classic UMD/webpack
       bundle isn't idempotent to that (it throws "Cannot set property ... which has only a
       getter" on the second run), and jsDelivr's ESM wrapper for it doesn't expose constructable
       classes correctly, so neither of three.js's fixes applies here. Guard explicitly instead:
       only inject the real <script src> the first time; the second execution sees window.BABYLON
       already set and no-ops. *@
    <script>
        (function () {
            // A synchronous flag, not `if (window.BABYLON)` — the script is still loading
            // asynchronously when the second (hydrate) execution of this tag would otherwise
            // also see BABYLON undefined and inject a second copy.
            if (window.__cursoryBabylonLoading) return;
            window.__cursoryBabylonLoading = true;
            var s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/babylonjs@7.36.0/babylon.max.js';
            s.crossOrigin = 'anonymous';
            document.head.appendChild(s);
        })();
    </script>
}

<div class="room-shell">
    <div class="room-hud">
        <span class="room-hud-name">@DisplayName</span>
        <span class="room-hud-dot" style="background:@Color"></span>
        <span id="room-status" class="room-status room-status-connecting" title="Connection status">Connecting…</span>
        <span class="room-hud-spacer"></span>
        <span class="room-hud-hint">ESC — menu</span>
    </div>
    @* Pause menu: shown whenever the pointer isn't captured (on load and after ESC). Holds the
       controls that used to sit in the top bar, plus Resume which re-captures the cursor. *@
    <div id="room-pause" class="room-pause" hidden>
        <div class="room-pause-card">
            <div class="room-pause-title">Paused</div>
            <button id="room-pause-resume" type="button" class="room-pause-resume">Resume</button>
            <label class="room-pause-level">
                Level
                @* Only render the levels the server can actually load (RoomState.LevelCount).
                   LevelNames is the master list of the 14 designed puzzles. *@
                <select id="room-level-select">
                    @for (var i = 1; i <= RoomState.LevelCount && i <= LevelNames.Length; i++)
                    {
                        <option value="@i">@i — @LevelNames[i - 1]</option>
                    }
                </select>
            </label>
            <div class="room-pause-toggles">
                <label class="room-pause-check"><input type="checkbox" id="room-toggle-collision" /> Cursor collision</label>
                <label class="room-pause-check"><input type="checkbox" id="room-toggle-rope" /> Segmented rope physics</label>
            </div>
            <button id="room-reset-btn" type="button" class="room-pause-btn">Restart level</button>
            <form method="post" action="/api/auth/logout" class="room-pause-logout">
                <AntiforgeryToken />
                <button type="submit" class="room-pause-btn">Sign out</button>
            </form>
        </div>
    </div>
    <div id="room-level-banner" class="room-level-banner" hidden>
        <div class="room-level-banner-title" id="room-level-banner-title"></div>
        <div class="room-level-banner-sub"   id="room-level-banner-sub"></div>
    </div>
    <div id="room-vote-overlay" class="room-vote-overlay" hidden>
        <div class="room-vote-card">
            <div class="room-vote-title" id="room-vote-title">Vote in progress</div>
            <div class="room-vote-tally"><span id="room-vote-yes">0</span> yes / <span id="room-vote-need">0</span> needed · <span id="room-vote-no">0</span> no</div>
            <div class="room-vote-buttons">
                <button type="button" id="room-vote-yes-btn" class="room-vote-yes">Yes</button>
                <button type="button" id="room-vote-no-btn"  class="room-vote-no">No</button>
            </div>
        </div>
    </div>
    <div id="room-context-menu" class="room-context-menu" hidden>
        <div class="room-context-item room-context-item-disabled">TBD</div>
    </div>
    <div id="room-viewport" class="room-viewport">
        <canvas id="room-canvas"></canvas>
        @* WebGL engines draw the solid game world here; cursors/tethers/whistles/labels/minimap
           still need a 2D context, so they get a transparent layer on top (see room-core.js).
           canvas2d has no need for this — it draws everything on #room-canvas directly. *@
        @if (Engine != "canvas2d")
        {
            <canvas id="room-overlay"></canvas>
        }
    </div>
</div>

@code {
    private static readonly string[] KnownEngines = ["canvas2d", "three", "babylon"];

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [Parameter] public string Engine { get; set; } = "";

    private string DisplayName { get; set; } = "";
    private string UserId { get; set; } = "";
    private string Color { get; set; } = "#7F77DD";

    // Master list of the 14 designed puzzles (commit 541d39e). The dropdown above renders only
    // the first RoomState.LevelCount of these, so the menu can never offer a level the server
    // would silently reject.
    private static readonly string[] LevelNames =
    [
        "Drop it on the pad", "Too heavy for one", "Pivot the couch", "Stand together, then heave",
        "Heavy heave", "Mirror match", "Stand and slide", "Block taxi", "Couch corner",
        "Tug steady", "Two-key lock", "Spinner", "Door hold", "Light the bulb",
    ];

    private IJSObjectReference? jsModule;

    protected override async Task OnInitializedAsync()
    {
        if (Array.IndexOf(KnownEngines, Engine) < 0)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        var state = await AuthStateTask;
        var user = state.User;
        DisplayName = user.Identity?.Name ?? "Anon";
        UserId = user.FindFirst("UserId")?.Value ?? "";
        Color = user.FindFirst("Color")?.Value ?? "#7F77DD";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Array.IndexOf(KnownEngines, Engine) < 0) return;
        jsModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Engine}/room.js");
        await jsModule.InvokeVoidAsync("start", new
        {
            userId = UserId,
            displayName = DisplayName,
            color = Color,
            worldWidth = WorldGeometry.Width,
            worldHeight = WorldGeometry.Height,
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            try { await jsModule.InvokeVoidAsync("stop"); } catch { }
            await jsModule.DisposeAsync();
        }
    }
}
